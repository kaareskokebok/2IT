<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Påmelding Gullklumpen</h1>

    <form action="/paamelding" method="post">
        <label for="inpAntall">Antall personer (150,- stykk):
        </label><br>
        <input type="number" id="inpAntall" name="inpAntall">
        <input type="submit" value="Send påmelding">
    </form>
    <% if(locals.antall) { %>
        <h2>Kvittering på påmelding</h2>
    <ul><li>Antall personer: <%= antall %> </li>
    <li>Pris pr stk: <%= stykkpris %></li>
    <li>Totalpris: <%= pris %> kr</li>
    </ul>
    <%} %>
    
</body>
</html>